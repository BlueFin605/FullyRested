{
  "name": "fullyrested",
  "productName": "FullyRested",
  "version": "1.1.0",
  "description": "A desktop REST client whose collections are plain files",
  "author": "BlueFin605",
  "license": "GPL-3.0",
  "main": "main.js",
  "repository": "https://github.com/BlueFin605/FullyRested",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:core && electron-forge start",
    "prebuild": "node scripts/help-index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "npm run build:core && npm run build && electron .",
    "package": "npm run build:core && npm run build && electron-forge package",
    "make": "npm run build:core && npm run build && electron-forge make",
    "build:core": "npm --prefix ../core run build",
    "icons:master": "node scripts/restore-alpha.mjs",
    "icons": "node scripts/make-icons.mjs",
    "help:screenshots": "node scripts/help-screenshots.mjs",
    "pretest:main": "npm --prefix ../cli-command run build",
    "test:main": "node --test \"main-tests/*.test.js\""
  },
  "private": true,
  "dependencies": {
    "@fullyrested/core": "file:../core",
    "@napi-rs/keyring": "^2.1.0",
    "electron-squirrel-startup": "^1.0.0",
    "update-electron-app": "^3.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@lezer/highlight": "^1.2.5",
    "@types/jasmine": "~4.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "marked": "18.0.14",
    "material-icons": "^1.13.14",
    "png2icons": "^2.0.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "zone.js": "~0.15.1"
  }
}
