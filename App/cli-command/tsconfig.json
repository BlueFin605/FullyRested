{
    "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "strict": true,
      "target": "es2020",
      "lib": ["es2020"],
      "module": "node16",
      "sourceMap": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "moduleResolution": "node16",
      "types": ["node"]
    },
    "include": ["src/**/*"]
  }
