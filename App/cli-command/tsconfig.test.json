// Type-checks the test files too: tsconfig.json builds src only, and vitest never type-checks,
// so without this a type error in a test reaches CI unnoticed.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "sourceMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*"]
}
